        public int Continue()
        {
            PostEvent(this, XEventID.CONTINUE);
            return 0;
        }

        public int Stop()
        {
            PostEvent(xStation, XEventID.STOPMUSTRESET);
            return 0;
        }

        private int Waiting(int timeout)
        {
            sw.Restart();
            while (true)
            {
                if (m_OnSignaled)
                {
                    sw.Reset();
                    lock (this)
                    {
                        m_Status = 0;
                    }
                    break;
                }
                if (sw.ElapsedMilliseconds > timeout)
                {
                    sw.Reset();
                    lock (this)
                    {
                        m_Wait = false;
                        m_Timeout = true;
                        m_Status = -2;
                    }
                    break;
                }

                Thread.Sleep(10);
            }
            return m_Status;
        }

        public int WaitDi(int[] DiNo, DISTSTYPE[] DiStsType, int Count, int timeout, bool timeoutToBeContinue, string alarmInfo = "")
        {
            lock (this)
            {
                for (int i = 0; i < Count; i++)
                {
                    m_DiId[i] = DiNo[i];
                    m_DiStsType[i] = DiStsType[i];
                }
                m_Count = Count;
                m_Timeout = false;
                m_Status = 0;
                m_OnSignaled = false;
                m_Wait = false;
                ErrorMessage = "";
            }
            _mre.Reset();
            _mreTimeout.Reset();
            //PostEvent(this, XEventID.WAITDI);
            PrimOnWait();
            sw.Restart();
            int waitStatus = 0;
            do
            {
                if (m_Wait == true)
                {
                    //if (CheckDiSts() != 0)
                    if (CheckDiSts_New() != 1)
                    {
                        m_Timeout = false;
                        m_Wait = false;
                        waitStatus = 0;
                        m_Status = 0;
                        m_OnSignaled = true;
                        sw.Reset();
                        //_mre.Set();
                    }
                    if (CheckDiSts_New() == 1)
                        break;
                }
                if (timeout > 0)
                {
                    if (sw.ElapsedMilliseconds > timeout)
                    {
                        sw.Reset();
                        m_Status = -2;
                        break;
                    }
                    else
                        break;
                }

                Thread.Sleep(10);
            } while (true);

            if (timeout > 0)
            {
                //if (Waiting(timeout) == -2)
                if (m_Status == -2)
                {
                    bool IsShowDlg = false;
                    for (int i = 0; i < m_Count; i++)
                    {
                        string msg = MultiLanguage.GetMessage(XDevice.Instance.FindDiById(m_DiId[i]).Name);
                        switch (m_DiStsType[i])
                        {
                            case DISTSTYPE.HIGH:
                                {
                                    if (XDevice.Instance.FindDiById(m_DiId[i]).STS == DISTSTYPE.HIGH)
                                    {
                                        ErrorMessage += "[" + msg + "]";
                                        if (timeoutToBeContinue == false)
                                        {
                                            PostEvent(xStation, XAlarmLevel.STOP, XAlarmId.WAITDI_TIMEOUT, m_DiId[i], true);
                                        }
                                        else
                                        {
                                            PostEvent(xStation, XAlarmLevel.TIP, XAlarmId.WAITDI_TIMEOUT, m_DiId[i], true);
                                            IsShowDlg = true;
                                        }
                                    }
                                    break;
                                }
                            case DISTSTYPE.LOW:
                                {
                                    if (XDevice.Instance.FindDiById(m_DiId[i]).STS == DISTSTYPE.LOW)
                                    {
                                        ErrorMessage += "[" + msg + "]";
                                        if (timeoutToBeContinue == false)
                                        {
                                            PostEvent(xStation, XAlarmLevel.STOP, XAlarmId.WAITDI_TIMEOUT, m_DiId[i], false);
                                        }
                                        else
                                        {
                                            PostEvent(xStation, XAlarmLevel.TIP, XAlarmId.WAITDI_TIMEOUT, m_DiId[i], false);
                                            IsShowDlg = true;
                                        }
                                    }
                                    break;
                                }
                            case DISTSTYPE.PLS:
                                {
                                    ErrorMessage += "[" + msg + "]";
                                    if (XDevice.Instance.FindDiById(m_DiId[i]).PLS == false)
                                    {
                                        if (timeoutToBeContinue == false)
                                        {
                                            PostEvent(xStation, XAlarmLevel.STOP, XAlarmId.WAITDI_TIMEOUT, m_DiId[i], true);
                                        }
                                        else
                                        {
                                            PostEvent(xStation, XAlarmLevel.TIP, XAlarmId.WAITDI_TIMEOUT, m_DiId[i], true);
                                            IsShowDlg = true;
                                        }
                                    }
                                    break;
                                }
                            case DISTSTYPE.PLF:
                                {
                                    ErrorMessage += "[" + msg + "]";
                                    if (XDevice.Instance.FindDiById(m_DiId[i]).PLF == false)
                                    {
                                        if (timeoutToBeContinue == false)
                                        {
                                            PostEvent(xStation, XAlarmLevel.STOP, XAlarmId.WAITDI_TIMEOUT, m_DiId[i], false);
                                        }
                                        else
                                        {
                                            PostEvent(xStation, XAlarmLevel.TIP, XAlarmId.WAITDI_TIMEOUT, m_DiId[i], false);
                                            IsShowDlg = true;
                                        }
                                    }
                                    break;
                                }
                        }
                    }
                    if (IsShowDlg == true)
                    {
                        ErrorMessage += MultiLanguage.GetMessage("等待信号超时");
                        ErrorMessage += alarmInfo;
                        ShowTimeoutDlg();
                        _mreTimeout.WaitOne();
                    }
                }
            }
            //else
            //{
            //    _mre.WaitOne(-1);
            //}
            return m_Status;
        }
        
        public int WaitDiSignal(int[] DiNo, DISTSTYPE[] DiStsType, int Count, int timeout)
        {
            lock (this)
            {
                for (int i = 0; i < Count; i++)
                {
                    m_DiId[i] = DiNo[i];
                    m_DiStsType[i] = DiStsType[i];
                }
                m_Count = Count;
                m_Timeout = false;
                m_Status = 0;
                m_OnSignaled = false;
                m_Wait = false;
                ErrorMessage = "";
            }
            _mre.Reset();
            _mreTimeout.Reset();
            PostEvent(this, XEventID.WAITDI);
            if (timeout > 0)
            {
                Waiting(timeout);
            }
            return m_Status;
        }

        private void ShowTimeoutDlg()
        {
            XTimeoutTip xtt = new XTimeoutTip(xStation.Name + ":\r\n" + ErrorMessage);
            xtt.ShowDialog();
            xtt.WaitOne();
            xtt.Reset();
            if (xtt.DialogResult == System.Windows.Forms.DialogResult.OK)
            {
                Continue();
            }
            else if (xtt.DialogResult == System.Windows.Forms.DialogResult.No)
            {
                Stop();
            }
        }
    }
}
