namespace XCore
{
    public enum LanguageType
    {
        Chinese = 0,
        English,
        Vietnamese
    }

    public delegate void CustomizeUpdateFormCtrlFunc();  // 定制化更新窗体的空间，例如 ListBox，GridViewCtrl等控件

    public delegate void UpdateProjectSettingFunc(string langStr);  // 定制化更新窗体的空间，例如 ListBox，GridViewCtrl等控件

    public class MultiLanguage
    {
        private static LanguageType m_CurLanguage = LanguageType.English;
        public static SerializableDictionary<string, Language> settingDic = new SerializableDictionary<string, Language>();
        public static SerializableDictionary<string, Language> categoryDic = new SerializableDictionary<string, Language>();
        public static SerializableDictionary<string, Language> positionName = new SerializableDictionary<string, Language>();
        public static LanguageType CurrentLanguage 
        {
            get
            {
                return m_CurLanguage;
            }
        }

        public static string GetPositonName(string key)
        {
            if (!positionName.ContainsKey(key)) return key;
            switch (CurrentLanguage)
            {
                case LanguageType.Chinese:
                    return positionName[key].Chinese;
                case LanguageType.English:
                    return positionName[key].English;
                case LanguageType.Vietnamese:
                    return positionName[key].Vietnamese;
                default:
                    return positionName[key].Chinese;
            }
        }
        private static Dictionary<Form, CustomizeUpdateFormCtrlFunc> m_RegisterForms = new Dictionary<Form, CustomizeUpdateFormCtrlFunc>();


        private static UpdateProjectSettingFunc m_UpdateProjectSettingFunc; 
        private static Dictionary<string, List<string>> m_MultiLangDict = new Dictionary<string,List<string>>();

        public static void RegisterForms(Form from, CustomizeUpdateFormCtrlFunc updateFormContainerCtrl = null)
        {
            if (!m_RegisterForms.Keys.Contains(from))
            {
                m_RegisterForms.Add(from, updateFormContainerCtrl);
            }

        }

        /// <summary>  
        /// 修改默认语言  
        /// </summary>  
        /// <param name="lang">待设置默认语言</param>  
        private static void SetCurLanguage(LanguageType langType)
        {
            string lang = GetLanguageString(langType);
            
            System.Threading.Thread.CurrentThread.CurrentUICulture = new System.Globalization.CultureInfo(lang);
            m_CurLanguage = langType;

            if (null != m_UpdateProjectSettingFunc)
                m_UpdateProjectSettingFunc(lang);
        }

        /// <summary>
        /// 注册设置语言的方法
        /// </summary>
        /// <param name="langType"></param>
        /// <returns></returns>
        public static void RegisterSettingLanguageFunc(UpdateProjectSettingFunc updateProjectSettingFunc)
        {
            m_UpdateProjectSettingFunc = updateProjectSettingFunc;
        }

        /// <summary>
        /// 获取语言类别的字符串
        /// </summary>
        /// <param name="langType"></param>
        /// <returns></returns>
        private static string GetLanguageString(LanguageType langType)
        {
            string langRes = "zh-CN";
            switch (langType)
            {
                case LanguageType.English:
                    langRes = "en-US";
                    break;
                case LanguageType.Vietnamese:
                    langRes = "vi";
                    break;
                default:
                    break;
            }
            return langRes;
        }

        public delegate void FuncLoadLanguage(Form form, Type formType);
        /// <summary>  
        /// 加载语言  
        /// </summary>  
        /// <param name="form">加载语言的窗口</param>  
        /// <param name="formType">窗口的类型</param>  
        public static void LoadLanguage(Form form, Type formType)
        //public static void LoadLanguage(Control ctrl, Type formType)
        {
            if (form != null)
            {
                //if (form.InvokeRequired)
                //{
                //    form.Invoke(new FuncLoadLanguage(LoadLanguage), new object[] { form, formType});
                //    return;
                //}
                System.ComponentModel.ComponentResourceManager resources = new System.ComponentModel.ComponentResourceManager(formType);
                resources.ApplyResources(form, "$this");
                Loading(form, resources);
                if (m_RegisterForms[form] != null)
                {
                    m_RegisterForms[form]();
                }
            }
        }

        /// <summary>  
        /// 加载语言  
        /// </summary>  
        /// <param name="control">控件</param>  
        /// <param name="resources">语言资源</param>  
        private static void Loading(Control control, System.ComponentModel.ComponentResourceManager resources)
        {
            if (control is MenuStrip)
            {
                //将资源与控件对应  
                resources.ApplyResources(control, control.Name);
                MenuStrip ms = (MenuStrip)control;
                if (ms.Items.Count > 0)
                {
                    foreach (ToolStripMenuItem c in ms.Items)
                    {
                        //遍历菜单  
                        Loading(c, resources);
                    }
                }
            }

            foreach (Control c in control.Controls)
            {
                if (c is UserControl)  // 如果是自定义控件，找自定义控件对应的资源文件
                {                   
                    System.ComponentModel.ComponentResourceManager rsc = new System.ComponentModel.ComponentResourceManager(c.GetType());
                    //rsc.ApplyResources(c, "$this");
                    foreach (Control ctrl in c.Controls)
                    {
                        if (ctrl.Controls.Count > 0)
                            Loading(ctrl, rsc);
                        else
                        {
                            rsc.ApplyResources(ctrl, ctrl.Name);
                        }
                    }
                }
                else
                {
                    if(c.Controls.Count > 0)
                        Loading(c, resources);
                    else
                        resources.ApplyResources(c, c.Name);
                }
            }

        }


        /// <summary>  
        /// 遍历菜单  
        /// </summary>  
        /// <param name="item">菜单项</param>  
        /// <param name="resources">语言资源</param>  
        private static void Loading(ToolStripMenuItem item, System.ComponentModel.ComponentResourceManager resources)
        {
            if (item is ToolStripMenuItem)
            {
                resources.ApplyResources(item, item.Name);
                ToolStripMenuItem tsmi = (ToolStripMenuItem)item;
                if (tsmi.DropDownItems.Count > 0)
                {
                    foreach (ToolStripMenuItem c in tsmi.DropDownItems)
                    {
                        Loading(c, resources);
                    }
                }
            }
        }

        // 修改当前语言
        public static void ChangeLanguage(LanguageType type, bool forceToChange = false)
        {
            if (m_CurLanguage == type && !forceToChange)
                return;
            m_CurLanguage = type;

            MultiLanguage.SetCurLanguage(m_CurLanguage);

            foreach (var item in m_RegisterForms)
            {
                //if (item.Key.InvokeRequired)
                //    continue;
                if (item.Key.IsHandleCreated)
                    MultiLanguage.LoadLanguage(item.Key, item.Key.GetType());
            }
        }

        // 对于跨线程的窗体,可以调用此函数更新窗体控件语言
        public static void LoadFormLangResource(Form form)
        {
            string lang = GetLanguageString(m_CurLanguage);
            System.Threading.Thread.CurrentThread.CurrentUICulture = new System.Globalization.CultureInfo(lang);
            MultiLanguage.LoadLanguage(form, form.GetType());
        }

