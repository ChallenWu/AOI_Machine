        private static string GetMessageFrDict(string msgDef)
        {
            //return GetMessage(ConvertToMsgDef(msgDef));            
            if (m_MultiLangDict.Keys.Contains(msgDef))
            {
                if (m_CurLanguage == LanguageType.English)
                    return m_MultiLangDict[msgDef][0];
                else if(m_CurLanguage == LanguageType.Vietnamese)
                    return m_MultiLangDict[msgDef][1];
            }
            return msgDef;            
        }

        public static string GetMessage(params string[] msgDef)
        {
            //return GetMessage(ConvertToMsgDef(msgDef));    
            string msg = string.Empty;
            for (int i = 0; i < msgDef.Length; i++)
            {
                if (i != 0 && m_CurLanguage == LanguageType.English)
                    msg += " ";
                msg += GetMessageFrDict(msgDef[i]);
            }
            return msg;
        }


        /// <summary> 
        /// 获取枚举值的描述文本 
        /// </summary> 
        /// <param name="value"></param> 
        /// <returns></returns> 
        private static MsgDef ConvertToMsgDef(string str)
        {
            MsgDef msg = MsgDef.None;
            try
            {
                msg = (MsgDef)Enum.Parse(typeof(MsgDef), str);
            }
            catch (Exception ex)
            {
                //BzMessageBox.Show(ex.Message);
                return msg;
            }
            return msg;
        }
        private static object ConvertToEnum(string str, Type type)
        {
            object msg = null;
            try
            {
                msg = Enum.Parse(type, str);
            }
            catch (Exception ex)
            {
                //BzMessageBox.Show(ex.Message);
                return msg;
            }
            return msg;
        }

        #region load File
        /// <summary>
        /// 读取多语言的文件
        /// </summary>
        /// <param name="filePath"></param>
        /// <param name="text"></param>     
        public static bool ReadMultiLangFile(string filePath)
        {
            m_MultiLangDict.Clear();
            if (!File.Exists(filePath))
                return false;
            int version = 0;
            if (filePath.Contains(".xlsx"))
                version = 1;

            IWorkbook workBook;
            ISheet sheet;
            FileStream fs;
            try
            {
                fs = new FileStream(filePath, FileMode.Open, FileAccess.Read);
            }
            catch
            {
                return false;
            }

            if (version == 0)
                workBook = new HSSFWorkbook(fs);
            else
                workBook = new XSSFWorkbook(fs);


            sheet = workBook.GetSheetAt(0);

            // 从第一行开始读取
            for (int i = 1; i <= sheet.LastRowNum; i++)
            {
                IRow rw = sheet.GetRow(i);
                if (rw == null)
                    continue;
                if (rw.Cells.Count > 0 && rw.Cells[0].ToString() != string.Empty)
                {
                    string keyStr = rw.Cells[0].ToString();
                    string valueStr = string.Empty;
                    UnifyFormat(ref keyStr);  
                    List<string> otherLangList = new List<string>();
                    // 英语
                    if (rw.Cells.Count > 1 && rw.Cells[1].ToString() != string.Empty)
                    {
                        valueStr = rw.Cells[1].ToString();
                        UnifyFormat(ref valueStr);
                        otherLangList.Add(valueStr);
                    }
                    else
                    {
                        otherLangList.Add(keyStr.ToString());
                    }
                    // 越南语
                    if (rw.Cells.Count > 2 && rw.Cells[2].ToString() != string.Empty)
                    {
                        valueStr = rw.Cells[2].ToString();
                        UnifyFormat(ref valueStr);
                        otherLangList.Add(valueStr);
                    }
                    else
                    {
                        otherLangList.Add(keyStr.ToString());
                    }
  
                    if (!m_MultiLangDict.Keys.Contains(keyStr))
                        m_MultiLangDict.Add(keyStr, otherLangList);
                }

            }
            fs.Close();
            return true;
        }

        private static void UnifyFormat(ref string input)
        {
            if (input.Contains("\\\\"))
                input = input.Replace("\\\\", "\\");
        }

        public static void LoadFile(String filePath)
        {
            IWorkbook workbook = null;
            FileStream fs = null;
            try
            {
                using (fs = File.OpenRead(filePath))
                {
                    // 2007版本  
                    if (filePath.IndexOf(".xlsx") > 0)
                        workbook = new XSSFWorkbook(fs);
                    // 2003版本  
                    else if (filePath.IndexOf(".xls") > 0)
                        workbook = new HSSFWorkbook(fs);

                    LoadSetting(workbook);
                    LoadCagetory(workbook);
                    LoadPositionName(workbook);
                    workbook.Close();
                }
            }
            catch
            {
            }
        }

        private static void LoadSetting(IWorkbook wb)
        {
            ISheet sheet = null;
            if (wb != null)
            {
                sheet = wb.GetSheet("setting");
                if (sheet == null) return;
                for (int i = 1; i <= sheet.LastRowNum; i++)
                {
                    string key = sheet.GetRow(i).Cells[0].ToString();
                    IRow row = sheet.GetRow(i);
                    if (string.IsNullOrEmpty(key) || row.Cells.Count != 3) continue;
                    if (settingDic.ContainsKey(key)) continue;
                    MultiLanguage.settingDic.Add(key, new Language() { Chinese = key, English = sheet.GetRow(i).Cells[1].ToString(), Vietnamese = sheet.GetRow(i).Cells[2].ToString() });
                }
            }
        }

        private static void LoadCagetory(IWorkbook wb)
        {
            ISheet sheet = null;
            if (wb != null)
            {
                sheet = wb.GetSheet("category");
                if (sheet == null) return;
                for (int i = 1; i <= sheet.LastRowNum; i++)
                {
                    string key = sheet.GetRow(i).Cells[0].ToString();
                    if (string.IsNullOrEmpty(key)) continue;
                    MultiLanguage.categoryDic.Add(key, new Language() { Chinese = key, English = sheet.GetRow(i).Cells[1].ToString(), Vietnamese = sheet.GetRow(i).Cells[2].ToString() });
                }
            }
        }

        private static void LoadPositionName(IWorkbook wb)
        {
            ISheet sheet = null;
            if (wb != null)
            {
                sheet = wb.GetSheet("positionName");
                if (sheet == null) return;
                for (int i = 1; i <= sheet.LastRowNum; i++)
                {
                    string key = sheet.GetRow(i).Cells[0].ToString();
                    if (string.IsNullOrEmpty(key)) continue;
                    MultiLanguage.positionName.Add(key, new Language() { Chinese = key, English = sheet.GetRow(i).Cells[1].ToString(), Vietnamese = sheet.GetRow(i).Cells[0].ToString() });
                }
            }
        }

        public static string GetSettingName(string name)
        {
            if (!MultiLanguage.settingDic.ContainsKey(name)) return name;
            switch (MultiLanguage.CurrentLanguage)
            {
                case LanguageType.Chinese:
                    return MultiLanguage.settingDic[name].Chinese;
                case LanguageType.English:
                    return MultiLanguage.settingDic[name].English;
                case LanguageType.Vietnamese:
                    return MultiLanguage.settingDic[name].Vietnamese;
                default:
                    return MultiLanguage.settingDic[name].Chinese;
            }
        }

        #endregion
    }
